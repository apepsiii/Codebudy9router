# .env.example - Configuration for V2Fun Backend API

# Telegram Bot Configuration (Optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Get chat ID from @userinfobot or your chat
TELEGRAM_CHAT_ID=-1001234567890

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=5001
API_DEBUG=false

# Model Priority (comma-separated, best to worst)
MODEL_PRIORITY=nano-banana-pro,gpt-image-2,nano-banana-2,nano-banana-2-lite,qwen-edit

# Job Settings
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT=300
STATUS_CHECK_INTERVAL=5

# Account Pool Settings
ACCOUNT_RELOAD_INTERVAL=3600
MIN_ACCOUNTS_REQUIRED=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=v2fun_data/backend_api.log
